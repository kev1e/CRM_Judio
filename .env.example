# Copy to `.env` and replace every "change-me" value — or run `sh scripts/init-env.sh`,
# which does both. `.env` is ignored by Git. Never commit real values.

# --- PostgreSQL (used by the postgres container and to build DATABASE_URL in compose)
POSTGRES_DB=crm
POSTGRES_USER=crm
# Letters and digits only: the value is embedded in a connection URL.
POSTGRES_PASSWORD=change-me-postgres-password

# --- Django
# At least 50 random characters. The API refuses to start with a placeholder.
DJANGO_SECRET_KEY=change-me-django-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Telegram
# Token of the CRM bot from @BotFather. Without it the stack starts, but nobody
# can sign in: every login must be approved in Telegram. Never commit a real token.
TELEGRAM_BOT_TOKEN=

# --- Browser access
# Addresses at which people open the CRM. Browser requests that change anything
# are accepted only from these origins.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Keep `true`. Browsers accept Secure cookies on http://localhost and http://127.0.0.1;
# set `false` only to open a local stack by another plain-HTTP address.
SESSION_COOKIE_SECURE=true
# Number of reverse proxies in front of the API that append to X-Forwarded-For.
# 0 = ignore the header. A wrong value lets a client forge its address.
TRUSTED_PROXY_HOPS=0

# --- Used only when the apps run on the host (pnpm/uv), not inside compose.
# Compose builds its own values that point at the `postgres`, `redis` and `api` services.
DATABASE_URL=postgres://crm:change-me-postgres-password@127.0.0.1:5432/crm
REDIS_URL=redis://127.0.0.1:6379/0
API_INTERNAL_URL=http://127.0.0.1:8000
