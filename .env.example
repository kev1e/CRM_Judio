# Copy to `.env` and replace every "change-me" value — or run `sh scripts/init-env.sh`,
# which does both. `.env` is ignored by Git. Never commit real values.

# --- PostgreSQL (used by the postgres container and to build DATABASE_URL in compose)
POSTGRES_DB=crm
POSTGRES_USER=crm
# Letters and digits only: the value is embedded in a connection URL.
POSTGRES_PASSWORD=change-me-postgres-password

# --- Django
# At least 50 random characters. The API refuses to start with a placeholder.
DJANGO_SECRET_KEY=change-me-django-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Used only when the apps run on the host (pnpm/uv), not inside compose.
# Compose builds its own values that point at the `postgres`, `redis` and `api` services.
DATABASE_URL=postgres://crm:change-me-postgres-password@127.0.0.1:5432/crm
REDIS_URL=redis://127.0.0.1:6379/0
API_INTERNAL_URL=http://127.0.0.1:8000
